/* Course Quiz Studio — VS Code Dark Modern inspired theme */

/*
   Workbench: #181818   Editor: #1f1f1f   Surface: #252526
   Input:     #313131   Border: #3c3c3c   Text:    #cccccc
   Muted:     #9d9d9d   Primary:#0078d4   Focus:   #007fd4
   Danger:    #f14c4c
*/

/* Global surfaces and typography */
QWidget {
    color: #cccccc;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QDialog {
    background-color: #1f1f1f;
}

QMainWindow,
QStackedWidget {
    background-color: #1f1f1f;
}

QLabel {
    color: #cccccc;
    background-color: transparent;
}

QLabel:disabled {
    color: #656565;
}

/* Buttons: secondary by default, blue only for primary actions */
QPushButton {
    min-height: 20px;
    padding: 5px 14px;
    color: #cccccc;
    background-color: #313131;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #3c3c3c;
    border-color: #4c4c4c;
}

QPushButton:pressed {
    background-color: #252526;
}

QPushButton:focus {
    border-color: #007fd4;
}

QPushButton:disabled {
    color: #656565;
    background-color: #252526;
    border-color: #2b2b2b;
}

QPushButton#primaryButton,
QPushButton#homeStartBtn,
QPushButton#dialogGenerateBtn,
QPushButton#dialogSaveBtn {
    color: #ffffff;
    background-color: #0078d4;
    border-color: #0078d4;
    font-weight: 600;
}

QPushButton#primaryButton:hover,
QPushButton#homeStartBtn:hover,
QPushButton#dialogGenerateBtn:hover,
QPushButton#dialogSaveBtn:hover {
    background-color: #026ec1;
    border-color: #026ec1;
}

QPushButton#secondaryButton {
    color: #cccccc;
    background-color: #313131;
    border-color: #3c3c3c;
}

QPushButton#dangerButton,
QPushButton#danger,
QPushButton#dialogRejectBtn {
    color: #ffffff;
    background-color: #5a1d1d;
    border-color: #f14c4c;
}

QPushButton#dangerButton:hover,
QPushButton#danger:hover,
QPushButton#dialogRejectBtn:hover {
    background-color: #6e2424;
}

QPushButton#dialogAcceptBtn {
    color: #ffffff;
    background-color: #2e6b3a;
    border-color: #4aa85d;
}

/* Sections */
QGroupBox {
    color: #cccccc;
    background-color: transparent;
    border: none;
    border-top: 1px solid #3c3c3c;
    border-radius: 0;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 0;
    padding: 0 8px 0 0;
    color: #cccccc;
    background-color: #1f1f1f;
}

QFrame#questionCard,
QFrame#reviewCard,
QFrame#feedbackFrame {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
}

QFrame#dividerLine {
    color: #3c3c3c;
    background-color: #3c3c3c;
}

/* Inputs */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QComboBox {
    color: #cccccc;
    background-color: #313131;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    padding: 5px 7px;
    selection-color: #ffffff;
    selection-background-color: #264f78;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #007fd4;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    color: #656565;
    background-color: #252526;
    border-color: #2b2b2b;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    border-left: 1px solid #3c3c3c;
}

QComboBox QAbstractItemView {
    color: #cccccc;
    background-color: #252526;
    border: 1px solid #454545;
    outline: none;
    selection-color: #ffffff;
    selection-background-color: #094771;
}

/* Lists and tables */
QListWidget,
QTreeWidget,
QTableWidget {
    color: #cccccc;
    background-color: #181818;
    alternate-background-color: #1f1f1f;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    outline: none;
}

QListWidget {
    padding: 4px;
}

QListWidget::item,
QTreeWidget::item {
    min-height: 24px;
    padding: 2px 6px;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #2a2d2e;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected {
    color: #ffffff;
    background-color: #094771;
}

QTableWidget {
    gridline-color: #2b2b2b;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    color: #cccccc;
    background-color: #252526;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    padding: 6px 8px;
    font-weight: 600;
}

/* Choice controls */
QCheckBox,
QRadioButton {
    color: #cccccc;
    background-color: transparent;
    spacing: 7px;
    padding: 3px 2px;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #ffffff;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 3px;
    background-color: #3c3c3c;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background-color: #0078d4;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background-color: #cccccc;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:focus {
    background-color: #ffffff;
    border-color: #007fd4;
}

/* Progress */
QProgressBar {
    min-height: 6px;
    color: #cccccc;
    background-color: #313131;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0078d4;
}

/* Workbench chrome */
QMenuBar,
QToolBar {
    color: #cccccc;
    background-color: #181818;
    border: none;
    border-bottom: 1px solid #2b2b2b;
}

QMenuBar::item {
    padding: 5px 9px;
}

QMenuBar::item:selected,
QToolBar QPushButton:hover {
    background-color: #2a2d2e;
}

QToolBar {
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar QPushButton {
    color: #cccccc;
    background-color: transparent;
    border-color: transparent;
    padding: 4px 10px;
}

QMenu {
    color: #cccccc;
    background-color: #252526;
    border: 1px solid #454545;
    padding: 4px;
}

QMenu::item {
    padding: 5px 28px 5px 20px;
}

QMenu::item:selected {
    color: #ffffff;
    background-color: #094771;
}

QStatusBar {
    color: #ffffff;
    background-color: #007acc;
}

/* Scroll areas and scrollbars */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
    background-color: #1f1f1f;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
    background-color: #1f1f1f;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 28px;
    min-width: 28px;
    background-color: #424242;
    border-radius: 0;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #5a5a5a;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}

/* Dialogs and tooltips */
QMessageBox,
QFileDialog {
    color: #cccccc;
    background-color: #1f1f1f;
}

QToolTip {
    color: #cccccc;
    background-color: #252526;
    border: 1px solid #454545;
    padding: 4px 6px;
}

/* Typography helpers */
QLabel#screenTitle {
    color: #f0f0f0;
    font-size: 20px;
    font-weight: 600;
    padding-bottom: 8px;
}

QLabel#screenSubtitle,
QLabel#homeSubtitle,
QLabel#settingsProviderHelp,
QLabel#settingsLocalAgentStatus,
QLabel#dialogStatusLabel,
QLabel#questionTypeLabel,
QLabel#resultsStatsLabel,
QLabel#resultsTopicStats,
QLabel#dashboardDetailLabel,
QLabel#quizTimerLabel {
    color: #9d9d9d;
}

QLabel#screenSubtitle,
QLabel#homeSubtitle {
    font-size: 14px;
}

QLabel#homeStatsLabel,
QLabel#setInfoLabel,
QLabel#resultsTopicStats,
QLabel#reviewExplanation {
    color: #9d9d9d;
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    padding: 10px;
}

QLabel#homeStatsLabel,
QLabel#dashboardRecentList,
QLabel#resultsStatsLabel {
    font-size: 13px;
}

QLabel#questionStem {
    color: #cccccc;
    font-size: 15px;
    padding: 6px 0;
}

QLabel#correctIndicator {
    font-size: 20px;
    font-weight: 600;
}

QLabel#resultsScoreLabel {
    color: #f0f0f0;
    font-size: 36px;
    font-weight: 600;
    padding: 16px;
}

QLabel#resultsReviewLabel,
QLabel#dialogPreviewLabel,
QLabel#quizProgressLabel {
    color: #cccccc;
    font-weight: 600;
}

QLabel#settingsVersionLabel {
    color: #656565;
    font-size: 11px;
    padding-top: 12px;
}

QLabel#dialogHeader {
    color: #cccccc;
    font-size: 14px;
    padding-bottom: 8px;
}

/* Domain-specific editors */
QTextEdit#courseSummaryPreview,
QTextEdit#questionBankEditor,
QTextEdit#dialogDetailEditor {
    font-family: Consolas, "Cascadia Mono", "Microsoft YaHei UI", monospace;
    font-size: 12px;
}

QTextEdit#dialogPromptPreview {
    color: #9d9d9d;
    font-size: 12px;
}

QPushButton#homeStartBtn {
    min-height: 34px;
    font-size: 15px;
}

QPushButton#homeActionBtn {
    min-height: 30px;
    font-size: 13px;
}

QPushButton#dialogGenerateBtn,
QPushButton#dialogSaveBtn {
    min-height: 26px;
    font-size: 14px;
}

QRadioButton#answerOption,
QLineEdit#fillInput,
QPlainTextEdit#shortAnswerInput {
    font-size: 14px;
}
